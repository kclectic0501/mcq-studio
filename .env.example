LLM_PROVIDER=huggingface
# The model must be available from a hosted Hugging Face inference provider.
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
HF_TOKEN=
# Optional judge overrides; configure both when switching provider families.
JUDGE_PROVIDER=
JUDGE_MODEL=
MAX_RETRIES=2
REQUEST_ATTEMPTS=3
MAX_CONCURRENCY=3
MODEL_TIMEOUT=90
APP_HOST=127.0.0.1
APP_PORT=7860
# Tracing sends document excerpts and generated quizzes to LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mcqgen
# Other providers require their package extra and standard environment credentials.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=